{
  "name": "modeler",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mcp": "node mcp/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "docs:api": "UPDATE_DOCS=1 vitest run tests/api-reference.test.ts",
    "mcp": "node mcp/dist/modeler-mcp.mjs"
  },
  "description": "Simple SketchUp-style 3D modeler for 3D printing and woodworking",
  "dependencies": {
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  },
  "private": true,
  "type": "module"
}
